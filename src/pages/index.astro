---
import Base from "../layouts/Base.astro";
import Findings from "../components/Findings.astro";
import meta from "../data/meta.json";
import figures from "../data/figures.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const stats = [
  [meta.datasets, "public CT datasets"], [meta.patients, "patients"], [meta.nodules, "nodules"],
  [meta.configurations, `configurations of ${meta.methods} methods`], [meta.features, "radiomic features"], [4, "analyses"],
];
const sections = [
  ["Build a comparison", "/build", "Pick datasets and methods as boxes; get the best performers in your selection and a figure you can download."],
  ["Explorer", "/explorer", "Heat map of every method in every dataset: nodules segmented, Dice, volume ratio, radiomic agreement and classification AUC."],
  ["Network", "/network", "Graph of methods, datasets and analyses: which datasets were in each method's training data, and which methods perform best where."],
  ["Methods", "/methods", "One page per configuration: how it is prompted, its training data, and its results in every analysis."],
  ["Datasets", "/datasets", "One page per dataset: patients, nodules, reference segmentation and example segmentations."],
  ["Radiomic features", "/features", "Agreement of all 107 features with radiologists, method by method, compared with agreement between radiologists."],
  ["Repeatability", "/repeatability", "Test–retest stability of features, volume and masks on CT repeated minutes or months apart."],
  ["Classification", "/classification", "Malignancy and suspicion AUC with features from each mask source, against reference masks, diameter and Lung-RADS."],
];
const fig4 = figures.find((f) => f.id === "4")!;
const ex = ["S5", "S6", "S7", "S8", "S9", "S10", "S11"].map((k) => figures.find((f) => f.id === k)!);
const exName: Record<string, string> = { S5: "LIDC-IDRI", S6: "LNDb", S7: "QIBA", S8: "IMD-CT", S9: "NSCLC-RG", S10: "QIN", S11: "LUAD-Surv" };
---
<Base title="NodSeg Atlas" active="/">
  <section class="hero">
    <div class="wrap">
      <span class="badge">Open benchmark · Lung nodule segmentation · CT</span>
      <h1>NodSeg <span class="red">Atlas</span></h1>
      <p class="dept">Tushar Lab · Department of Radiology and Imaging Sciences · University of Arizona</p>
      <p class="lead">How reliable are open-access lung nodule segmentation models beyond Dice? Explore {meta.configurations} configurations of {meta.methods} methods in {meta.datasets} public CT datasets: segmentation performance, agreement of radiomic features with radiologists, test–retest repeatability and classification.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:22px">
        <a class="btn btn-primary" href={`${base}/build/`}>Build a comparison</a>
        <a class="btn btn-outline" href={`${base}/explorer/`}>Open the explorer</a>
        <a class="btn btn-outline" href={`${base}/network/`}>See the network</a>
      </div>
      <div class="stats">
        {stats.map(([n, l]) => <div class="stat"><b>{n}</b><span>{l}</span></div>)}
      </div>
    </div>
  </section>
  <div style="background:var(--panel);border-bottom:1px solid var(--line)">
    <div class="wrap affil">
      <a href="https://tusharlabratory.github.io/" aria-label="Tushar Lab"><img class="lab" src={`${base}/brand/tusharlab-logo-crop.svg`} alt="Tushar Lab" /></a>
      <span class="div" aria-hidden="true"></span>
      <a href="https://radiology.arizona.edu/" aria-label="Department of Radiology and Imaging Sciences, University of Arizona"><img class="dept" src={`${base}/brand/radiology-imaging-sciences.png`} alt="Radiology and Imaging Sciences, University of Arizona" /></a>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="card" style="margin-bottom:30px"><div class="kicker">In one sentence</div><p style="margin:.4em 0 0;font-size:1.05rem">{meta.summary}</p></div>
      <h2 style="margin-top:0">Key findings</h2>
      <Findings />
      <h3 style="font-size:1.35rem;margin:34px 0 4px">Example segmentations</h3>
      <p class="muted" style="max-width:860px;margin-bottom:14px">One nodule per row, every configuration in its own column, with the reference outline dashed; the label gives Dice and the volume ratio. Pick a dataset for more examples.</p>
      <div class="exbox">
        <div class="seg" id="extabs">
          <button class="on" data-src={`${base}/data/${fig4.file}`} data-k="4">Overview</button>
          {ex.map((f) => <button data-src={`${base}/data/${f.file}`} data-k={f.id}>{exName[f.id]}</button>)}
        </div>
        <a id="exlink" href={`${base}/data/${fig4.file}`} target="_blank" rel="noopener"><img id="eximg" src={`${base}/data/${fig4.file}`} alt="Segmentation examples by each configuration" loading="lazy" /></a>
        <p class="muted" style="font-size:.8rem;margin:8px 0 0">Click the image to open it at full size. From the article, Figure <span id="exnum">4</span>.</p>
      </div>
    </div>
  </section>

  <section style="background:var(--panel)">
    <div class="wrap">
      <h2 style="margin-top:0">Explore the results</h2>
      <div class="grid">
        {sections.map(([t, href, d]) => (
          <a class="card" href={`${base}${href}/`}><div class="kicker">Explore</div><h3>{t}</h3><p class="muted" style="margin:0">{d}</p></a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 style="margin-top:0">The study</h2>
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
        <div class="card"><div class="kicker">Article</div><h3>{meta.title}</h3><p class="muted" style="margin:0">Preprint link coming soon.</p></div>
        <a class="card" href="https://tusharlabratory.github.io/lungfm-atlas.github.io/"><div class="kicker">Companion site</div><h3>LungFM Atlas</h3><p class="muted" style="margin:0">Frozen CT foundation models for lung cancer prediction: 18 encoders across 16 tasks in 12 public cohorts.</p></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .exbox { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 16px; box-shadow: var(--shadow); }
  .exbox .seg { flex-wrap: wrap; margin-bottom: 12px; }
  .exbox img { width: 100%; height: auto; display: block; border-radius: 6px; background: #000; }
</style>
<script>
  const tabs = document.getElementById("extabs")!;
  tabs.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button"); if (!b) return;
    [...tabs.children].forEach((x) => x.classList.toggle("on", x === b));
    (document.getElementById("eximg") as HTMLImageElement).src = b.dataset.src!;
    (document.getElementById("exlink") as HTMLAnchorElement).href = b.dataset.src!;
    document.getElementById("exnum")!.textContent = b.dataset.k!;
  });
</script>
